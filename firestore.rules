rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidRoomCodeFormat(code) {
      return code is string && code.matches('^[0-9]{6}$');
    }

    function isValidPinHashOrNull(value) {
      return value == null || (value is string && value.matches('^[a-f0-9]{64}$'));
    }

    match /events/{eventId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll([
          'id',
          'slug',
          'roomCode',
          'title',
          'description',
          'dateMode',
          'dates',
          'startHour',
          'endHour',
          'slotIntervalMin',
          'timezone',
          'hostUid',
          'hostName',
          'createdAt'
        ])
        && request.resource.data.id == eventId
        && request.resource.data.slug is string
        && request.resource.data.slug.size() >= 3
        && request.resource.data.slug.size() <= 60
        && isValidRoomCodeFormat(request.resource.data.roomCode)
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 3
        && request.resource.data.description.size() <= 300
        && request.resource.data.dateMode in ['specific_dates', 'days_of_week']
        && request.resource.data.dates is list
        && request.resource.data.dates.size() >= 1
        && request.resource.data.dates.size() <= 31
        && request.resource.data.startHour is int
        && request.resource.data.endHour is int
        && request.resource.data.startHour >= 0
        && request.resource.data.startHour <= 23
        && request.resource.data.endHour >= 1
        && request.resource.data.endHour <= 24
        && request.resource.data.endHour > request.resource.data.startHour
        && request.resource.data.slotIntervalMin == 30
        && request.resource.data.timezone is string
        && request.resource.data.hostName is string
        && request.resource.data.hostName.size() >= 1
        && request.resource.data.hostName.size() <= 50
        && request.resource.data.createdAt is int
        && request.resource.data.hostUid is string
        && request.resource.data.hostUid == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.hostUid != null
        && resource.data.hostUid == request.auth.uid
        && request.resource.data.id == resource.data.id
        && request.resource.data.slug == resource.data.slug
        && request.resource.data.roomCode == resource.data.roomCode
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isSignedIn()
        && resource.data.hostUid != null
        && resource.data.hostUid == request.auth.uid;

      match /participants/{participantId} {
        allow read: if true;

        allow create: if request.resource.data.keys().hasAll([
            'id',
            'eventId',
            'name',
            'normalizedName',
            'status',
            'authType',
            'googleUid',
            'pinHash',
            'availabilities',
            'updatedAt'
          ])
          && request.resource.data.id == participantId
          && request.resource.data.eventId == eventId
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 50
          && request.resource.data.normalizedName is string
          && request.resource.data.normalizedName.size() >= 1
          && request.resource.data.normalizedName.size() <= 50
          && request.resource.data.status in ['pending', 'filled']
          && request.resource.data.authType in ['roster', 'guest', 'google']
          && isValidPinHashOrNull(request.resource.data.pinHash)
          && request.resource.data.availabilities is map
          && request.resource.data.updatedAt is int
          && (
            request.resource.data.googleUid == null
            || (isSignedIn() && request.resource.data.googleUid == request.auth.uid)
          );

        allow update: if request.resource.data.keys().hasAll([
            'id',
            'eventId',
            'name',
            'normalizedName',
            'status',
            'authType',
            'googleUid',
            'pinHash',
            'availabilities',
            'updatedAt'
          ])
          && request.resource.data.id == resource.data.id
          && request.resource.data.eventId == resource.data.eventId
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 50
          && request.resource.data.status in ['pending', 'filled']
          && request.resource.data.authType in ['roster', 'guest', 'google']
          && request.resource.data.availabilities is map
          && request.resource.data.updatedAt is int
          && (
            resource.data.googleUid == null
              ? (
                  request.resource.data.googleUid == null
                  || (isSignedIn() && request.resource.data.googleUid == request.auth.uid)
                )
              : (
                  isSignedIn()
                  && resource.data.googleUid == request.auth.uid
                  && request.resource.data.googleUid == resource.data.googleUid
                )
          )
          && (
            resource.data.pinHash == null
              ? isValidPinHashOrNull(request.resource.data.pinHash)
              : request.resource.data.pinHash == resource.data.pinHash
          );

        allow delete: if false;
      }
    }

    match /roomCodes/{code} {
      // Lookup 1-read diizinkan untuk semua peserta, namun list/enumerasi dilarang.
      allow get: if true;
      allow list: if false;

      allow create: if isSignedIn()
        && isValidRoomCodeFormat(code)
        && request.resource.data.keys().hasAll(['code', 'eventId', 'slug', 'createdAt'])
        && request.resource.data.code == code
        && request.resource.data.eventId is string
        && request.resource.data.eventId.size() >= 1
        && request.resource.data.slug is string
        && request.resource.data.slug.size() >= 3
        && request.resource.data.createdAt is int;

      allow update, delete: if false;
    }

    match /userProfiles/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
