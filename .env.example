# ==============================================================================
# Salin file ini menjadi `.env` lalu isi kunci publik proyek Firebase Anda.
#
# Mode Pengembangan Lokal (Mock Fallback):
# Jika keenam variabel `NEXT_PUBLIC_FIREBASE_*` di bawah ini dibiarkan kosong,
# Jadwalin otomatis berjalan dalam Mode Mock Lokal (penyimpanan in-memory /
# `localStorage`) sehingga alur aplikasi & unit test dapat dijalankan tanpa
# koneksi Firebase live.
#
# Keamanan Data:
# Seluruh kunci `NEXT_PUBLIC_FIREBASE_*` memang bersifat publik untuk SDK klien
# browser. Pembatasan akses baca/tulis Firestore diatur oleh `firestore.rules`.
# Jangan pernah menaruh credential Firebase Admin SDK atau secret privat di sini.
# ==============================================================================

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Opsional — hanya diperlukan bila Firebase Analytics diaktifkan
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
